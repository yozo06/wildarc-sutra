{
  "name": "wildarc-sutra",
  "version": "0.1.0",
  "description": "WildArc's shared libraries: small pure functions, chained. First set: the pieces behind offline learning games (spaced repetition, streaks, save codes, translations, voice packs, anonymous analytics, story episodes, offline shell).",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yozo06/wildarc-sutra.git"
  },
  "keywords": [
    "wildarc",
    "learning",
    "spaced-repetition",
    "pwa",
    "offline-first",
    "functional",
    "i18n",
    "indic",
    "analytics"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./core": "./dist/core/index.js",
    "./srs": "./dist/srs/index.js",
    "./habit": "./dist/habit/index.js",
    "./save": "./dist/save/index.js",
    "./i18n": "./dist/i18n/index.js",
    "./audio": "./dist/audio/index.js",
    "./analytics": "./dist/analytics/index.js",
    "./story": "./dist/story/index.js",
    "./pwa": "./dist/pwa/index.js",
    "./browser": "./dist/browser/index.js"
  },
  "bin": {
    "sutra-sw": "./bin/sutra-sw.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test",
    "check": "npm run build && npm run rules && npm test",
    "prepare": "npm run build",
    "rules": "tsc -p tsconfig.pure.json && node scripts/check-rules.mjs"
  },
  "devDependencies": {
    "typescript": ">=5.6"
  },
  "homepage": "https://github.com/yozo06/wildarc-sutra#readme"
}
